<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_darog_packing">
        <t t-call="web.basic_layout">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Tinos:ital,wght@0,400;0,700;1,400;1,700&amp;display=swap');
                @page{
                    size: A4;
                    margin: 0.5in !important;
                }
                .page{
                    width: 100%;
                    height: 100%;
                    font-family: "Times New Roman", Times,"Tinos",serif !important;
                    font-size: 14px;
                    line-height: 1.1;
                    padding: 0.5in !important;
                    padding-right: 0.5in !important;
                    padding-left: 0.5in !important;
                }
                .logo{
                    text-align: center;
                    margin-top:0 !important;
                    padding: 0 !important;
                    border-bottom: 2px solid black;
                    margin-bottom: 20px;
                    justify-content: center;
                    align-items: center;
                    width: 100%;
                    overflow: hidden;
                }
                .logo img{
                    max-width:100%;
                    width:100%;
                    height: auto;
                }
                .report_footer{
                    position: running(report_footer);
                    width:100%;
                    text-align: center;
                    font-size: 12px;
                    margin-top: 20px;
                }
                .wavy-certificate-title {
                    font-family: 'Times New Roman', Times, serif; /* Matches the formal certificate serif font */
                    font-size: 3rem;
                    font-weight: bold;
                    letter-spacing: 2px;
                    color: #000000; /* Primary text color */
                    position: relative;
                    display: inline-block;
    
                    /* Creates the distinct, rigid shadow steps 
                    to simulate the printed/replicated "wavy" depth look
                    */
                    text-shadow: 
                        1px 1px 0px #999,
                        2px 2px 0px #888,
                        3px 3px 0px #777,
                        4px 4px 1px rgba(0,0,0,0.3);
                }
                tr,td{
                    padding-left: 5px;
                }
                .things td{
                    border: 1px solid black;
                    border-top: 0px solid white;
                    border-bottom: 0px solid white;
                }
                .hala td{
                    border-right: 0px solid white !important;
                    border-left: 0px solid white !important;
                }
            </style>
            <t t-foreach="docs" t-as="o">
                <!-- LOGO SECTION START-->
                <div class="logo">
                    <!-- <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Comapny Logo" style="width:100%;height:auto;display:block"/> -->
                </div>
                <!-- LOGO SECTION END-->
                <!-- MAIN BODY START-->
                <div class="page" style="padding-top: 150px !important;">
                    <div style="text-align: center; padding-top: 20px;">
                        <h3 style="display: inline-block; text-align: center; padding-top: 0px !important; padding-bottom: 0px !important; border: 1px solid black;padding-left: 5px; padding-right: 5px;"><strong>PACKING LIST</strong></h3>
                    </div>
                    <table style="width: 100%; border-collapse: collapse; margin-top: 20px;" class="things">
                        <tr>
                            <td style="text-align: left; border-top: 1px solid black; border-bottom: 1px solid black;">NAME &amp; ADDRESS :-</td>
                            <td colspan="2" style="border-top: 1px solid black !important;"><strong>NO. : <span style="padding-left: 12px;">DC/CI/<t t-esc="o.incoming_date.year"/>/<t t-esc="'{:03d}'.format(o.invoice_no)"/></span></strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important;"> </td>
                            <td colspan="2" style="border-top: 1px solid black;"><strong>DATE : <span style="padding-left: 10px;"><span t-esc="o.delivery_challan_date.strftime('%d.%m.%Y')"/></span></strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white; !important;">
                                <strong><span t-field="o.reciepent_id.name"/></strong><br/>
                                <span style="font-size: 12px;" t-field="o.reciepent_id.address"/>.
                            </td>
                            <td colspan="2">
                                <strong> NO OF L/C : <span t-field="o.lc_no"/></strong><br/>
                                <strong> DATE : <span t-esc="o.incoming_date.strftime('%d.%m.%Y')"/></strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important; border-top: 0px solid white !important;"></td>
                            <td colspan="2" style="border-top: 1px solid black !important; border-bottom: 1px solid black !important"><strong> L/C ISSUING BANK :- </strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important; border-top: 0px solid white !important;"> </td>
                            <td colspan="2" style="border-bottom: 0px solid white;"><strong><span t-field="o.reciepent_id.bank_id.name"/></strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important; border-top: 0px solid white !important;"></td>
                            <td style="border-top: 0px solid white !important;" colspan="2"> <span style="font-size: 12px;" t-field="o.reciepent_id.bank_id.address"/></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid black; border-bottom: 1px solid black;"><strong> EXPORT L/C OR SC NO. : </strong></td>
                            <td colspan="2" style="border-top: 1px solid black;border-bottom: 1px solid black;"><strong> PROFORMA INVOICE NO. : </strong></td>
                        </tr>
                        <tr>
                            <td>
                                <strong><span t-field="o.export_lc_no"/></strong>
                                <strong style="padding-left: 20px;"> DATE : <span t-esc="o.export_date.strftime('%d.%m.%Y')"/></strong><br/>
                                <table style="border: 0px solid white !important;" class="hala">
                                    <t t-set="cnt" t-value="0"/>
                                    <t t-if="o.tin_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS TIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.tin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>TIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.tin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.bin_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS BIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.bin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>BIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.bin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.irc_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS IRC NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.irc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>IRC NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.irc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.erc_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS ERC NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.erc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>ERC NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.erc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.bond_reg_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS BOND REG. NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.bond_reg_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>BOND REG. NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.bond_reg_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.bb_no_needed">
                                        <t t-if="cnt == 0">
                                        <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>ISSUING BANK BIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.bank_id.bank_bin"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>ISSUING BANK BIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.bank_id.bank_bin"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.ref_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td><strong>APPLICANTS REF. NO : </strong></td>
                                                <td style="text-align:left;padding-left: 5px;"> <t t-esc="o.ref_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;"><strong>REF NO : </strong></td>
                                                <td style="text-align:left;padding-left: 5px;"> <t t-esc="o.ref_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                </table>
                                <strong>BENEFICIARY BIN NO : 000008386-301</strong>
                            </td>
                            <td colspan="2">
                                <strong>DC/<t t-esc="o.incoming_date.year"/>/<t t-esc="'{:03d}'.format(o.invoice_no)"/></strong>
                                <strong style="padding-left: 20px;"> DATE : <span t-esc="o.invoice_date.strftime('%d.%m.%Y')"/></strong><br/><br/>
                                <strong>H.S. CODE : 6217.10.00.</strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-top: 1px solid black;"><strong>FROM : BENEFICIARY'S FACTORY</strong></td>
                            <td colspan="2" style="border-top: 1px solid black;"><strong> TO : OPENERS FACTORY</strong></td>
                        </tr>
                        <tr>
                            <td style="text-align:center; border-top: 1px solid black !important; border-bottom: 1px solid black !important;"> DESCRIPTION OF GOODS </td>
                            <td style="text-align:center; border-top: 1px solid black !important; border-bottom: 1px solid black !important;"> SIZE </td>
                            <td style="text-align:center; border-top: 1px solid black !important; border-bottom: 1px solid black !important;"> QUANTITY IN DZN </td>
                        </tr>
                        <!--ITEMS MEASUREMENT SECTION START-->
                        <t t-set="sorted_items" t-value="sorted(o.items_id, key=lambda i: (i.name == 'PAPER GUMTAPE', len(i.name or '')))"/>
                        <t t-foreach="sorted_items" t-as="item">
                            <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                <td><strong> <u><t t-esc="item.name"/></u></strong> </td>
                                <td></td>
                                <td></td>
                            </tr>
                            <t t-set="next_item" t-value="sorted_items[item_index + 1].name if not item_last else False"/>
                            <t t-foreach="o.measurement_ids" t-as="measurement">
                                <t t-if="measurement.items_id.name == item.name">
                                    <t t-if="item.name in ['PRE-PACK: MILKY WHITE','PRINTED POLY: MILKY WHITE']">
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;">L - <t t-esc="measurement.length"/> <t t-esc="(measurement.measure or '').upper()"/> + AD - <t t-esc="measurement.adhesive"/> <t t-esc="(measurement.measure or '').upper()"/> , W - <t t-esc="measurement.width"/> <t t-esc="(measurement.measure or '').upper()"/> </td>
                                            <td style="text-align:center; font-size:12px;"><t t-esc="measurement.length"/> X <t t-esc="measurement.width"/> + AD <t t-esc="measurement.adhesive"/> <t t-esc="(measurement.measure or '').upper()"/></td>
                                            <td style="text-align:center; font-size:12px;"><t t-esc="'{:.2f}'.format(measurement.quantity)"/></td>
                                        </tr>
                                    </t>
                                    <t t-elif="item.name not in ['PRE-PACK: MILKY WHITE','PRINTED-POLY: MILKY WHITE','PAPER GUMTAPE']">
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;">L - <t t-esc="measurement.length"/> <t t-esc="(measurement.measure or '').upper()"/> X W - <t t-esc="measurement.width"/> <t t-esc="(measurement.measure or '').upper()"/></td>
                                            <td style="text-align:center; font-size:12px !important;"><t t-esc="measurement.length"/> X <t t-esc="measurement.width"/> <t t-esc="(measurement.measure or '').upper()"/></td>
                                            <td style="text-align:center; font-size:12px !important;"><t t-esc="'{:.2f}'.format(measurement.quantity)"/></td>
                                        </tr>
                                    </t>
                                    <t t-elif="item.name in ['PAPER GUMTAPE']">
                                        <t t-set="gumtape" t-value="True"/>
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;"><t t-esc="item.description"/></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                        <t t-if="measurement.yards == 0">
                                            <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                                <td style="font-size:12px !important;">FREE QTY. : <t t-esc="'{:.2f}'.format(measurement.quantity)"/> ROLL. </td>
                                                <td style="text-align: center;font-size: 12px;"> 70 MM</td>
                                                <td style="text-align: center; font-size:12px !important;"><t t-esc="'{:.2f}'.format(measurement.quantity)"/> ROLL.</td>
                                            </tr>
                                        </t>
                                        <t t-elif="measurement.yards &gt; 0">
                                            <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                                <td style="font-size:12px !important;">QAUANTITY : <t t-esc="'{:.2f}'.format(measurement.quantity)"/> ROLL X <t t-esc="measurement.yards"/> YDS. = <t t-esc="o.total_roll"/> YDS. </td>
                                                <td style="text-align: center;font-size: 12px;"> 70MM</td>
                                                <td style="text-align: center; font-size:12px !important;"><t t-esc="'{:.2f}'.format(o.total_roll)"/> YDS. </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </t>
                            <t t-if="next_item == 'PAPER GUMTAPE'"> 
                                <tr style="border-bottom:0px solid white;border-top:0px solid white;">
                                    <td></td>
                                    <td></td>
                                    <td style="text-align: center;font-size: 12px;">DZN.</td>
                                </tr>
                            </t>
                        </t>
                        <tr>
                            <td style="border-top: 0px solid white !important;">
                                <t t-if="o.booking_type == 'booking'">
                                    <strong>BOOKING NO :</strong><br/>
                                </t>
                                <t t-elif="o.booking_type == 'po'">
                                    <strong>P.O. NO :</strong><br/>
                                </t>
                                <t t-elif="o.booking_type == 'styling'">
                                    <strong>STYLING NO :</strong><br/>
                                </t>
                                <t t-set="booking_list" t-value="o.booking_ids"/>
                                <t t-set="cnt" t-value="0"/>
                                <t t-foreach="booking_list" t-as="booking">
                                    <t t-if="cnt+len(booking.booking_no) &lt; 60">
                                        <strong> <t t-esc="booking.booking_no"/>. </strong>
                                        <t t-set="cnt" t-value="cnt + len(booking.booking_no)"/>
                                    </t>
                                    <t t-elif="cnt >= 3">
                                        <br/> <strong> <t t-esc="booking.booking_no"/>. </strong>
                                        <t t-set="cnt" t-value="len(booking.booking_no)"/>
                                    </t>
                                </t>
                                <br/>
                                <t t-if="o.net_weight">Net Weight: <strong><t t-esc="o.net_weight"/> KG </strong></t>
                                <t t-if="o.gross_weight">Gross Weight: <strong><t t-esc="o.gross_weight"/> KG </strong><br/></t>
                                <t t-if="o.goods_weight">Weight: <strong><t t-esc="o.goods_weight"/> KG </strong><br/></t>
                                <strong> BUYER : MANGO.</strong><br/>
                                <strong> QUANTITY: AS PER MANGO APPROVED. </strong>
                            </td>
                            <td style="border-top: 0px solid white !important;"></td>
                            <td style="border-top: 0px solid white !important"></td>
                        </tr>
                        <tr style="border-bottom: 1px solid black !important; border-top: 1px solid black !important;">
                            <td></td>
                            <td style="text-align:center;"> TOTAL </td>
                            <td style="text-align:center;"> <t t-esc="o.total_quantity"/> DZN <t t-if="gumtape == True"> + <t t-esc="o.total_roll"/> <t t-if="o.gumtape_yards">YDS.</t> <t t-else="">ROLL.</t></t></td>
                        </tr>
                    </table>
                    <p style="margin: 0 !important;">ACCESSORIES FOR 100% EXPORT ORIENTED GARMENTS INDUSTRIES </p>
                    <p style="margin: 0 !important;">WE DO HEREBY CERTIFY THAT THE MERCHANDISE ARE OF BANGLADESH ORIGIN.</p>
                    <!--
                    <div class="report_footer">
                        <table style="border: 0px solid white;width:100%;border-collapse:collapse;margin-top:20px;">
                            <tr>
                                <td style="text-align:center;font-size:12px;"><strong>Mailing Address: Flat # B-4, House # 16, Road # Sonargaon Janapath, Sector# 12, Uttara, Dhaka-1230.</strong></td>
                            </tr>
                            <tr>
                                <td style="text-align:center;font-size:12px;"><strong>Tell : 880-0171 2895173,E-mail:darogbd@gmail.com</strong></td>
                            </tr>
                        </table>
                    </div>
                    -->
                </div>
            </t>
        </t>
    </template>
</odoo>