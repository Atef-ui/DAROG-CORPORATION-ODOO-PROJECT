<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_darog_delivery">
        <t t-call="web.basic_layout">
            <style>
                @import url('https://fonts.googleapis.com/css2?family=Tinos:ital,wght@0,400;0,700;1,400;1,700&amp;display=swap');
                @page{
                    size: A4;
                    /* Reduced from 0.5in to 0.3in — leaves more vertical room */
                    margin: 0.5in !important;
                }
                .page{
                    width: 100%;
                    height: 100%;
                    font-family: "Times New Roman", Times,"Tinos",serif !important;
                    font-size: 14px;
                    line-height: 1.3;
                    /* Removed horizontal padding — @page margin already handles it */
                    padding-left: 0.5in !important;
                    padding-right: 0.5in !important;
                }
                .logo{
                    text-align: center;
                    margin-top: 0 !important;
                    padding: 0 !important;
                    border-bottom: 2px solid black;
                    /* Reduced from 20px */
                    margin-bottom: 8px;
                    justify-content: center;
                    align-items: center;
                    width: 100%;
                    overflow: hidden;
                }
                .logo img{
                    max-width: 100%;
                    width: 100%;
                    height: auto;
                }
                .report_footer{
                    position: running(report_footer);
                    width: 100%;
                    text-align: center;
                    font-size: 12px;
                    /* Reduced from 20px */
                    margin-top: 8px;
                }
                td{
                    padding-left: 5px;
                    /* Tighten default cell vertical padding */
                }
            </style>
            <t t-foreach="docs" t-as="o">
                <!-- LOGO SECTION START-->
                <div class="logo">
                    <!-- <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" alt="Comapny Logo" style="width:100%;height:auto;display:block"/> -->
                </div>
                <!-- LOGO SECTION END-->
                <!-- MAIN BODY START-->
                <!--
                    IMPORTANT: padding-top here is the space reserved for your pre-printed pad header.
                    Original was 150px. Adjust this single value to match your pad's header height exactly.
                    Common values: 100px (small header) | 120px (medium) | 150px (large).
                    If your pad header is shorter, reduce this first — it's the biggest space-saver.
                -->
                <div class="page" style="padding-top: 150px !important;">
                    <!-- Reduced padding-top from 20px to 4px on heading div -->
                    <div style="text-align: center; padding-top: 4px;">
                        <h2 style="display: inline-block; text-align: center;
                                   margin-top: 0; margin-bottom: 4px;
                                   padding-top: 1px !important; padding-bottom: 1px !important;
                                   border: 1px solid black;
                                   padding-left: 2px !important; padding-right: 2px !important;">
                            <strong>DELIVERY CHALLAN</strong>
                        </h2>
                    </div>
                    <!-- Reduced margin-top from 20px to 6px -->
                    <table style="width: 100%; border-collapse: collapse; margin-top: 6px;">
                        <tr>
                            <td style="text-align: left;">NAME &amp; ADDRESS :-</td>
                            <td colspan="2"><strong>NO : <span style="padding-left: 12px;">DC/CI/<t t-esc="o.incoming_date.year"/>/<t t-esc="'{:03d}'.format(o.invoice_no)"/></span></strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important;"> </td>
                            <td colspan="2"><strong>DATE : <span style="padding-left: 10px;"><span t-esc="o.delivery_challan_date.strftime('%d.%m.%Y')"/></span></strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white; !important;">
                                <strong><span t-field="o.reciepent_id.name"/></strong><br/>
                                <span style="font-size: 13px;" t-field="o.reciepent_id.address"/>.
                            </td>
                            <td colspan="2">
                                <strong> NO OF L/C : <span t-field="o.lc_no"/></strong><br/>
                                <strong> DATE : <span t-esc="o.incoming_date.strftime('%d.%m.%Y')"/></strong>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important; border-top: 0px solid white !important;"></td>
                            <td colspan="2"><strong> L/C ISSUING BANK :- </strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important; border-top: 0px solid white !important;"> </td>
                            <td colspan="2" style="border-bottom: 0px solid white;"><strong><span t-field="o.reciepent_id.bank_id.name"/></strong></td>
                        </tr>
                        <tr>
                            <td style="border-bottom: 0px solid white !important; border-top: 0px solid white !important;"></td>
                            <td style="border-top: 0px solid white !important;" colspan="2"> <span style="font-size: 13px;" t-field="o.reciepent_id.bank_id.address"/></td>
                        </tr>
                        <tr>
                            <td style="border-top:1px solid black;"><strong> EXPORT L/C OR SC NO. :</strong></td>
                            <td colspan="2"><strong> PROFORMA INVOICE NO. : </strong></td>
                        </tr>
                        <tr>
                            <td>
                                <strong><span t-field="o.export_lc_no"/></strong>
                                <strong style="padding-left: 20px;"> DATE : <span t-esc="o.export_date.strftime('%d.%m.%Y')"/></strong><br/>
                                <table style="border: 0px solid white !important; border-collapse: collapse;">
                                    <t t-set="cnt" t-value="0"/>
                                    <t t-if="o.tin_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;text-align:right;padding-right: 5px;"><strong>APPLICANTS TIN NO </strong></td>
                                                <td style="text-align:left;">: <t t-esc="o.reciepent_id.tin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>TIN NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.tin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.bin_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;text-align:right;padding-right: 5px;"><strong>APPLICANTS BIN NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.bin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="white-space: nowrap;text-align:right;padding-right: 5px;"><strong>BIN NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.bin_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.irc_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS IRC NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.irc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>IRC NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.irc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.erc_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS ERC NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.erc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>ERC NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.erc_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.bond_reg_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>APPLICANTS BOND REG. NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.bond_reg_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>BOND REG. NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.bond_reg_no"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="o.bb_no_needed">
                                        <t t-if="cnt == 0">
                                            <tr>
                                                <td style="white-space: nowrap;padding-right: 5px;"><strong>ISSUING BANK BIN NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.bank_id.bank_bin"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                        <t t-elif="cnt &gt; 0">
                                            <tr>
                                                <td style="text-align:right;padding-right: 5px;"><strong>ISSUING BANK BIN NO </strong></td>
                                                <td style="text-align:left;padding-right: 5px;">: <t t-esc="o.reciepent_id.bank_id.bank_bin"/></td>
                                                <t t-set="cnt" t-value="cnt + 1"/>
                                            </tr>
                                        </t>
                                    </t>
                                </table>
                                <strong>BENEFICIARY BIN NO: 000008386-301</strong>
                            </td>
                            <td colspan="2">
                                <strong>DC/<t t-esc="o.incoming_date.year"/>/<t t-esc="'{:03d}'.format(o.invoice_no)"/></strong>
                                <strong style="padding-left: 20px;"> DATE : <span t-esc="o.invoice_date.strftime('%d.%m.%Y')"/></strong>
                                <!-- Removed <br/><br/> (was 2 blank lines), replaced with single br -->
                                <br/><br/>
                                <strong style="vertical-align: bottom;">HS. CODE : 6217.10.00</strong>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>FROM : BENEFICIARY'S FACTORY</strong></td>
                            <td colspan="2"><strong> TO : OPENERS FACTORY</strong></td>
                        </tr>
                        <tr>
                            <td style="text-align:center;"> DESCRIPTION OF GOODS </td>
                            <td style="text-align:center;"> SIZE </td>
                            <td style="text-align:center;"> QUANTITY IN DZN </td>
                        </tr>
                        <!--ITEMS MEASUREMENT SECTION START-->
                        <t t-set="sorted_items" t-value="sorted(o.items_id, key=lambda i: (i.name == 'PAPER GUMTAPE', len(i.name or '')))"/>
                        <t t-set="gumtape" t-value="False"/>
                        <t t-foreach="sorted_items" t-as="item">
                            <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                <td><strong> <u><t t-esc="item.name"/></u></strong> </td>
                                <td></td>
                                <td></td>
                            </tr>
                            <t t-set="next_item" t-value="sorted_items[item_index + 1].name if not item_last else False"/>
                            <t t-foreach="o.measurement_ids" t-as="measurement">
                                <t t-if="measurement.items_id.name == item.name">
                                    <t t-if="item.name in ['PRE-PACK: MILKY WHITE','PRINTED POLY: MILKY WHITE']">
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;">L - <t t-esc="measurement.length"/> <t t-esc="measurement.measure"/> + AD - <t t-esc="measurement.adhesive"/> <t t-esc="measurement.measure"/> , W - <t t-esc="measurement.width"/> <t t-esc="measurement.measure"/> </td>
                                            <td style="text-align:center; font-size:12px;"><t t-esc="measurement.length"/> X <t t-esc="measurement.width"/> + AD <t t-esc="measurement.adhesive"/> <t t-esc="measurement.measure"/></td>
                                            <td style="text-align:center; font-size:12px;"><t t-esc="'{:.2f}'.format(measurement.quantity)"/></td>
                                        </tr>
                                    </t>
                                    <t t-elif="item.name not in ['PRE-PACK: MILKY WHITE','PRINTED-POLY: MILKY WHITE','PAPER GUMTAPE']">
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;">L - <t t-esc="measurement.length"/> <t t-esc="measurement.measure"/> X W - <t t-esc="measurement.width"/> <t t-esc="measurement.measure"/></td>
                                            <td style="text-align:center; font-size:12px !important;"><t t-esc="measurement.length"/> X <t t-esc="measurement.width"/> <t t-esc="measurement.measure"/></td>
                                            <td style="text-align:center; font-size:12px !important;"><t t-esc="'{:.2f}'.format(measurement.quantity)"/></td>
                                        </tr>
                                    </t>
                                    <t t-elif="item.name in ['PAPER GUMTAPE']">
                                        <t t-set="gumtape" t-value="True"/>
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;"><t t-esc="item.description"/></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                        <tr style="border-bottom:0px solid white !important;border-top:0px solid white !important;">
                                            <td style="font-size:12px !important;">FREE QTY. : <t t-esc="'{:.2f}'.format(measurement.quantity)"/> ROLL. </td>
                                            <td style="text-align: center;font-size: 12px;"> 70 MM</td>
                                            <td style="text-align: center; font-size:12px !important;"><t t-esc="'{:.2f}'.format(measurement.quantity)"/> ROLL</td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                            <t t-if="next_item == 'PAPER GUMTAPE'"> 
                                <tr style="border-bottom:0px solid white;border-top:0px solid white;">
                                    <td></td>
                                    <td></td>
                                    <td style="text-align: center;font-size: 12px;">DZN.</td>
                                </tr>
                            </t>
                        </t>
                        <tr>
                            <td style="border-top: 0px solid white !important;">
                                <t t-if="o.booking_type == 'booking'">
                                    <strong>BOOKING NO : </strong><br/>
                                </t>
                                <t t-elif="o.booking_type == 'po'">
                                    <strong>P.O. NO : </strong><br/>
                                </t>
                                <t t-elif="o.booking_type == 'styling'">
                                    <strong>STYLING NO : </strong><br/>
                                </t>
                                <t t-set="booking_list" t-value="o.booking_ids"/>
                                <t t-set="cnt" t-value="0"/>
                                <t t-foreach="booking_list" t-as="booking">
                                    <t t-if="cnt+len(booking.booking_no) &lt; 60">
                                        <strong> <t t-esc="booking.booking_no"/>. </strong>
                                        <t t-set="cnt" t-value="cnt + len(booking.booking_no)"/>
                                    </t>
                                    <t t-elif="cnt >= 3">
                                        <br/> <strong> <t t-esc="booking.booking_no"/>. </strong>
                                        <t t-set="cnt" t-value="len(booking.booking_no)"/>
                                    </t>
                                </t>
                                <br/>
                                <t t-if="o.net_weight">Net Weight: <strong><t t-esc="o.net_weight"/> KG </strong></t>
                                <t t-if="o.gross_weight">Gross Weight: <strong><t t-esc="o.gross_weight"/> KG </strong><br/></t>
                                <t t-if="o.goods_weight">Weight: <strong><t t-esc="o.goods_weight"/> KG </strong><br/></t>
                                <strong> BUYER : MANGO.</strong><br/>
                                <strong> QUANTITY: AS PER MANGO APPROVED. </strong>
                            </td>
                            <td style="border-top: 0px solid white !important;"></td>
                            <td style="border-top: 0px solid white !important"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align:center;"> TOTAL </td>
                            <td style="text-align:center;"> <t t-esc="o.total_quantity"/> DZN <t t-if="gumtape == True"> + <t t-esc="o.total_roll"/> ROLL</t></td>
                        </tr>
                    </table>
                    <!-- Reduced paragraph margins -->
                    <p style="margin: 1px 0 !important;">ACCESSORIES FOR 100% EXPORT ORIENTED GARMENTS INDUSTRIES </p>
                    <p style="margin: 1px 0 !important;">WE DO HEREBY CERTIFY THAT THE MERCHANDISE ARE OF BANGLADESH ORIGIN.</p>
                    <p style="margin: 1px 0 !important;">GOODS RECEIVED IN GOOD CONDITION</p>
                    <p style="margin: 1px 0 !important;">RECIEVED BY................</p>
                </div>
            </t>
        </t>
    </template>
</odoo>