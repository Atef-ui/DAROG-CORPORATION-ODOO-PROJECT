<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="report_paperformate" model="report.paperformat">
        <field name="name">DAROG Report</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_darog" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">darog.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">DAROG.report_darog</field>
        <field name="report_file">DAROG.report_darog</field>
        <field name="print_report_name">'Invoice - %s' % (object.reciepent_id.name)</field>
        <field name="binding_model_id" ref="DAROG.model_darog_order"/>
        <field name="paperformat_id" ref="report_paperformate"/>
        <field name="binding_type">report</field>
    </record>
</odoo>