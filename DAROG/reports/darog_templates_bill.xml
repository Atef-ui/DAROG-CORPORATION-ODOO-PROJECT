            <style>
                @import url('https://fonts.googleapis.com/css2?family=Tinos:ital,wght@0,400;0,700;1,400;1,700&amp;display=swap');
                @page{
                    size: A4;
                    margin-top: 1.5in !important;
                    margin-bottom: 1.5in !important;
                    margin-left: 1.5in !important;
                    margin-right: 1.5in !important;
                    padding-right: 1.5in !important;
                    padding-left: 1.5in !important;
                }
                .page{
                    width: 100%;
                    height: 100%;
                    font-family: "Times New Roman", Times,"Tinos",serif !important;
                    font-size:15px;
                    padding: 0.5in !important;
                }
                body{
