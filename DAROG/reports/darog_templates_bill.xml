                            <td style="text-align:left;">DC/CI/<t t-esc="o.invoice_date.year"/>/<t t-esc="'{:03d}'.format(o.invoice_no)"/></td>
                            <td style="text-align: right;">Date: <t t-esc="o.delivery_challan_date.strftime('%d.%m.%Y')"/></td>
                        </tr>
                        <tr>
                            <td style="text-align:left;">For <u>USD <t t-esc="o.total_amount"/></u></td>
                        </tr>
                    </table>
                    <table style="border: 0px solid white;border-collapse: collapse; width: 100%;">
                        <tr>
                            <td style="text-transform: none;">At <t t-esc="o.payment_within"/> <strong>Days</strong> <i>Sight of this</i> <strong>FIRST</strong> <i>Bill Of Exchange</i> ( <i><strong> SECOND </strong> of the same tenor and date being unpaid</i> )</td>
                        </tr>
                        <tr>
                            <td>Pay to <strong>Uttara Bank Ltd, Banijya Shakha, 34,Garib-E-Newaz Avenue, Sector#13, Uttara, Dhaka-1230. OR </strong></td>
                        </tr>
                        <tr>
                            <td><strong>Order the SUM of (USD$ <t t-esc="o.amount_in_words"/>) </strong> Value</td>
                        </tr>
                        <tr>
