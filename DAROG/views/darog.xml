<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="darog_company_tree_view" model="ir.ui.view">
        <field name="name">darog.company.tree</field>
        <field name="model">darog.company</field>
        <field name="arch" type="xml">
            <list string="Company Tree">
                <field name="name"/>
                <field name="logo" widget='image'/>
            </list>
        </field>
    </record>
    <record id="darog_company_form_view" model="ir.ui.view">
        <field name="name">darog.company.form</field>
        <field name="model">darog.company</field>
        <field name="arch" type="xml">
            <form string="Company Form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                        <field name="logo" widget='image'/>
                        <field name="certificate" widget='image'/>
                        <field name="hs_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_company_action" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">darog.company</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <record id="darog_company_orders_tree_view" model="ir.ui.view">
        <field name="name">Company Orders</field>
        <field name="model">darog.order</field>
        <field name="arch" type="xml">
            <list decoration-success="order_status == 'delivered'" decoration-danger="order_status not in ['delivered']">
                <field name="reciepent_id"/>
                <field name="order_status"/>
                <field name="incoming_date"/>
            </list>
        </field>
    </record>
    <record id="darog_company_orders_form_view" model="ir.ui.view">
        <field name="name">Company Orders Form</field>
        <field name="model">darog.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_backfill_invoice_numbers" string="Assign Invoice No" type="object" class="btn-secondary" invisible="0" help="Assign invoice number to existing orders"/>
                </header>
                <sheet>
                    <group>
                        <field name="order_status" widget="statusbar" options="{'clickable': 'True'}"/>
                    </group>
                    <group>
                        <field name="reciepent_id"/>
                        <field name="total_amount"/>
                        <field name="company_id"/>
                        <field name="lc_no"/>
                        <field name="export_lc_no"/>
                        <field name="invoice_no"/>
                        <field name="goods_weight"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="items_id"/>
                            <group>
                                <field name="net_weight" string="NET WEIGHT:"/>
                                <field name="gross_weight" string="GROSS WEIGHT:"/>
                            </group>
                        </page>
                        <page string="Measurements">
                            <field name="measurement_ids">
                                <list>
                                    <field name="items_id"/>
                                    <field name="width"/>
                                    <field name="length"/>
                                    <field name="adhesive"/>
                                    <field name="measure"/>
                                    <field name="quantity"/>
                                    <field name="quantity_unit"/>
                                    <field name="per_unit_price"/>
                                    <field name="total_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bank Details">
                            <group>
                                <field name="reciepent_id" string="FACTORY: "/>
                            </group>
                            <field name="bank_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="address"/>
                                </list>
                            </field>
                        </page>
                        <page string="Bookings">
                            <group>
                                <field name="booking_type" string="BOOKING TYPE: "/>
                            </group>
                            <field name="booking_ids">
                                <list>
                                    <field name="order_id"/>
                                    <field name="booking_no"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dates">
                            <group>
                                <field name="invoice_date"/>
                                <field name="incoming_date"/>
                                <field name="delivery_challan_date"/>
                                <field name="delivery_date"/>
                                <field name="export_date"/>
                            </group>
                        </page>
                        <page string="Other Details">
                            <group>
                                <field name="payment_within"/>
                                <field name="tin_no_needed"/>
                                <field name="bin_no_needed"/>
                                <field name="irc_no_needed"/>
                                <field name="erc_no_needed"/>
                                <field name="bond_reg_no_needed"/>
                                <field name="bb_no_needed"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_company_orders_action" model="ir.actions.act_window">
        <field name="name">Company Orders</field>
        <field name="res_model">darog.order</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <record id="darog_company_reciepent_tree_view" model="ir.ui.view">
        <field name="name">Company Reciepent Tree</field>
        <field name="model">darog.reciepent</field>
        <field name="arch" type="xml">
            <list string="Company Reciepent Tree">
                <field name="name"/>
                <field name="address"/>
            </list>
        </field>
    </record>
    <record id="darog_company_reciepent_form_view" model="ir.ui.view">
        <field name="name">Company Reciepent Form</field>
        <field name="model">darog.reciepent</field>
        <field name="arch" type="xml">
            <form string="Company Reciepent Form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                        <field name="default_invoice_no"/>
                        <field name="bin_no"/>
                        <field name="tin_no"/>
                        <field name="irc_no"/>
                        <field name="erc_no"/>
                        <field name="bond_reg_no"/>
                        <field name="bb_no"/>
                        <field name="bank_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_company_reciepent_action" model="ir.actions.act_window">
        <field name="name">Company Reciepents</field>
        <field name="res_model">darog.reciepent</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <record id="darog_company_items_tree_view" model="ir.ui.view">
        <field name="name">Company Items Tree</field>
        <field name="model">darog.item</field>
        <field name="arch" type="xml">
            <list string="Company Items Tree">
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="darog_company_items_form_view" model="ir.ui.view">
        <field name="name">Company Items Form</field>
        <field name="model">darog.item</field>
        <field name="arch" type="xml">
            <form string="Company Items Form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_comapny_items_action" model="ir.actions.act_window">
        <field name="name">Company Items</field>
        <field name="res_model">darog.item</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <record id="darog_company_measurement_tree_view" model="ir.ui.view">
        <field name="name">Company Measurement Tree</field>
        <field name="model">darog.measurement</field>
        <field name="arch" type="xml">
            <list string="Company Measurement Tree">
                <field name="items_id"/>
                <field name="width"/>
                <field name="length"/>
                <field name="adhesive"/>
                <field name="measure"/>
                <field name="quantity"/>
                <field name="quantity_unit"/>
                <field name="per_unit_price"/>
                <field name="total_price"/>
            </list>
        </field>
    </record>
    <record id="darog_company_measurement_form_view" model="ir.ui.view">
        <field name="name">Company Measurement Form</field>
        <field name="model">darog.measurement</field>
        <field name="arch" type="xml">
            <form string="Company Measurement Form">
                <sheet>
                    <group>
                        <field name="orders_id"/>
                        <field name="items_id"/>
                        <field name="width" invisible="items_id.name in ['PAPER GUMTAPE','']"/>
                        <field name="length" invisible="items_id.name in ['PAPER GUMTAPE','']"/>
                        <field name="adhesive" invisible="items_id.name in ['PAPER GUMTAPE','']"/>
                        <field name="measure"/>
                        <field name="quantity"/>
                        <field name="quantity_unit"/>
                        <field name="per_unit_price"/>
                        <field name="total_price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_company_bank_tree_view" model="ir.ui.view">
        <field name="name">Company Bank Tree</field>
        <field name="model">darog.bank</field>
        <field name="arch" type="xml">
            <list string="Company Bank Tree">
                <field name="name"/>
                <field name="address"/>
                <field name="reciepent_id"/>
            </list>
        </field>
    </record>
    <record id="darog_company_bank_form_view" model="ir.ui.view">
        <field name="name">Company Bank</field>
        <field name="model">darog.bank</field>
        <field name="arch" type="xml">
            <form string="Company Bank Form">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="address"/>
                        <field name="reciepent_id"/>
                        <field name="bank_bin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_company_bank_action" model="ir.actions.act_window">
        <field name="name">Company Bank</field>
        <field name="res_model">darog.bank</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <record id="darog_company_measurement_action" model="ir.actions.act_window">
        <field name="name">Company Measurement</field>
        <field name="res_model">darog.measurement</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <record id="darog_company_booking_tree_view" model="ir.ui.view">
        <field name="name">Company Booking Tree</field>
        <field name="model">darog.booking</field>
        <field name="arch" type="xml">
            <list string="Company Booking Tree">
                <field name="booking_no"/>
                <field name="order_id"/>
            </list>
        </field>
    </record>
    <record id="darog_company_booking_form_view" model="ir.ui.view">
        <field name="name">Company Booking Form</field>
        <field name="model">darog.booking</field>
        <field name="arch" type="xml">
            <form string="Company Booking Form">
                <sheet>
                    <group>
                        <field name="booking_no"/>
                        <field name="order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="darog_company_booking_action" model="ir.actions.act_window">
        <field name="name">Company Booking</field>
        <field name="res_model">darog.booking</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="darog_menu_root" name="Darog"/>
    <menuitem id="darog_menu_company" name="Companies" parent="darog_menu_root" action="darog_company_action"/>
    <menuitem id="darog_menu_orders" name="Orders" parent="darog_menu_root" action="darog_company_orders_action"/>
    <menuitem id="darog_menu_reciepents" name="Reciepents" parent="darog_menu_root" action="darog_company_reciepent_action"/>      
    <menuitem id="darog_menu_items" name="Items" parent="darog_menu_root" action="darog_comapny_items_action"/>
    <menuitem id="darog_menu_measurements" name="Measurements" parent="darog_menu_root" action="darog_company_measurement_action"/>
    <menuitem id="darog_menu_banks" name="Banks" parent="darog_menu_root" action="darog_company_bank_action"/>
</odoo>