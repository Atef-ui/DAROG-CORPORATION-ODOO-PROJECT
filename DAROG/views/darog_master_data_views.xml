<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Items -->
    <record id="darog_company_items_tree_view" model="ir.ui.view">
        <field name="name">darog.item.list</field>
        <field name="model">darog.item</field>
        <field name="arch" type="xml">
            <list string="Items" editable="bottom" default_order="name">
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="print_style"/>
                <field name="price_per_unit"/>
            </list>
        </field>
    </record>

    <record id="darog_company_items_form_view" model="ir.ui.view">
        <field name="name">darog.item.form</field>
        <field name="model">darog.item</field>
        <field name="arch" type="xml">
            <form string="Item">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. PRE-PACK: MILKY WHITE"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="price_per_unit"/>
                        </group>
                        <group>
                            <field name="print_style"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="darog_comapny_items_action" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">darog.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Banks -->
    <record id="darog_company_bank_tree_view" model="ir.ui.view">
        <field name="name">darog.bank.list</field>
        <field name="model">darog.bank</field>
        <field name="arch" type="xml">
            <list string="Banks" default_order="name">
                <field name="name"/>
                <field name="address"/>
                <field name="reciepent_id"/>
                <field name="bank_bin" optional="show"/>
            </list>
        </field>
    </record>

    <record id="darog_company_bank_form_view" model="ir.ui.view">
        <field name="name">darog.bank.form</field>
        <field name="model">darog.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sonali Bank PLC"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="address"/>
                            <field name="bank_bin"/>
                        </group>
                        <group>
                            <field name="reciepent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="darog_company_bank_action" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">darog.bank</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Buyers -->
    <record id="darog_buyer_tree_view" model="ir.ui.view">
        <field name="name">darog.buyer.list</field>
        <field name="model">darog.buyer</field>
        <field name="arch" type="xml">
            <list string="Buyers" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="darog_buyer_action" model="ir.actions.act_window">
        <field name="name">Buyers</field>
        <field name="res_model">darog.buyer</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a buyer</p>
        </field>
    </record>

    <!-- Order lines (measurements) -->
    <record id="darog_company_measurement_tree_view" model="ir.ui.view">
        <field name="name">darog.measurement.list</field>
        <field name="model">darog.measurement</field>
        <field name="arch" type="xml">
            <list string="Order Lines">
                <field name="orders_id"/>
                <field name="items_id"/>
                <field name="length"/>
                <field name="width"/>
                <field name="adhesive" optional="show"/>
                <field name="measure"/>
                <field name="yards" optional="hide"/>
                <field name="quantity" sum="Total"/>
                <field name="quantity_unit"/>
                <field name="per_unit_price"/>
                <field name="cost_price" optional="show"/>
                <field name="total_price" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="darog_company_measurement_form_view" model="ir.ui.view">
        <field name="name">darog.measurement.form</field>
        <field name="model">darog.measurement</field>
        <field name="arch" type="xml">
            <form string="Order Line">
                <sheet>
                    <group>
                        <group>
                            <field name="orders_id"/>
                            <field name="items_id"/>
                            <field name="print_style" invisible="1"/>
                        </group>
                        <group string="Size" invisible="print_style == 'gumtape'">
                            <field name="length"/>
                            <field name="width"/>
                            <field name="adhesive" invisible="print_style != 'poly'"/>
                            <field name="measure"/>
                        </group>
                        <group string="Quantity &amp; Price">
                            <field name="yards" invisible="print_style != 'gumtape'"/>
                            <field name="quantity"/>
                            <field name="quantity_unit"/>
                            <field name="per_unit_price"/>
                            <field name="cost_price"/>
                            <field name="total_price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="darog_measurement_search_view" model="ir.ui.view">
        <field name="name">darog.measurement.search</field>
        <field name="model">darog.measurement</field>
        <field name="arch" type="xml">
            <search string="Order Lines">
                <field name="orders_id"/>
                <field name="items_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_item" string="Item" context="{'group_by': 'items_id'}"/>
                    <filter name="group_order" string="Order" context="{'group_by': 'orders_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="darog_company_measurement_action" model="ir.actions.act_window">
        <field name="name">Order Lines</field>
        <field name="res_model">darog.measurement</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Bookings -->
    <record id="darog_company_booking_tree_view" model="ir.ui.view">
        <field name="name">darog.booking.list</field>
        <field name="model">darog.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings">
                <field name="booking_no"/>
                <field name="order_id"/>
            </list>
        </field>
    </record>

    <record id="darog_company_booking_form_view" model="ir.ui.view">
        <field name="name">darog.booking.form</field>
        <field name="model">darog.booking</field>
        <field name="arch" type="xml">
            <form string="Booking">
                <sheet>
                    <group>
                        <field name="booking_no"/>
                        <field name="order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="darog_company_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">darog.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
