<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="darog_company_reciepent_tree_view" model="ir.ui.view">
        <field name="name">darog.reciepent.list</field>
        <field name="model">darog.reciepent</field>
        <field name="arch" type="xml">
            <list string="Recipients">
                <field name="name"/>
                <field name="address"/>
                <field name="bin_no" optional="show"/>
                <field name="tin_no" optional="hide"/>
                <field name="order_count" string="Orders"/>
            </list>
        </field>
    </record>

    <record id="darog_company_reciepent_form_view" model="ir.ui.view">
        <field name="name">darog.reciepent.form</field>
        <field name="model">darog.reciepent</field>
        <field name="arch" type="xml">
            <form string="Recipient">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. ABC Garments Ltd."/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="address" placeholder="Factory address as printed on documents"/>
                        </group>
                        <group string="Registration Numbers">
                            <field name="bin_no"/>
                            <field name="tin_no"/>
                            <field name="irc_no"/>
                            <field name="erc_no"/>
                            <field name="bond_reg_no"/>
                            <field name="bb_no"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Banks" name="banks">
                            <field name="bank_id" context="{'default_reciepent_id': id}">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="address"/>
                                    <field name="bank_bin"/>
                                </list>
                            </field>
                        </page>
                        <page string="Invoicing" name="invoicing">
                            <group>
                                <group>
                                    <field name="default_invoice_no"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="darog_reciepent_search_view" model="ir.ui.view">
        <field name="name">darog.reciepent.search</field>
        <field name="model">darog.reciepent</field>
        <field name="arch" type="xml">
            <search string="Recipients">
                <field name="name"/>
                <field name="bin_no"/>
                <field name="tin_no"/>
                <field name="bank_id" string="Bank"/>
            </search>
        </field>
    </record>

    <record id="darog_company_reciepent_action" model="ir.actions.act_window">
        <field name="name">Recipients</field>
        <field name="res_model">darog.reciepent</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a recipient</p>
            <p>Recipients are the factories that open the back-to-back L/C.</p>
        </field>
    </record>
</odoo>
